<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Post</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<style>

</style>
<body>
    <h1>Add new Post</h1>
    <form action="/posts" method="POST">
        <input type="text" name="title" placeholder="Enter post title" required class="title-input">
        <textarea name="content" placeholder="Enter post content" required class="content-input"></textarea>
        <button type="submit" class="submit-btn">Add Post</button>
    </form>
</body>
</html>